# Base Postgres Neon. Sans elle, toute route de données echoue explicitement (B-2).
DATABASE_URL=

# Secret de signature du cookie de session. 32 octets aleatoires au minimum.
# Generation : openssl rand -base64 32
SESSION_SECRET=

# Fournisseur du modele de vision : « mistral » (defaut) ou « gemini ».
# Le basculement ne demande que cette variable, l'application ne connait que
# l'interface commune de src/server/clients/vision.ts.
VISION_PROVIDER=gemini

# Cle Google AI Studio, si VISION_PROVIDER=gemini. Serveur uniquement.
# Le palier gratuit suffit largement (quelques photos par jour), mais Google
# se reserve d'exploiter les contenus soumis pour ameliorer ses produits, revue
# humaine comprise. Pour une app qui porte des donnees de sante de tiers, passer
# au palier payant est le choix propre.
# GEMINI_MODEL est optionnelle. Defaut gemini-3.6-flash : gemini-2.5-flash
# repond 404 aux comptes recents, et les modeles plus recents repondent souvent
# 503 sur le palier gratuit.
GEMINI_API_KEY=
GEMINI_MODEL=

# Cle du modele de vision Mistral, si VISION_PROVIDER=mistral.
# Serveur uniquement, jamais de prefixe NEXT_PUBLIC_ (AD-4).
# La cle doit avoir un quota actif : sans credit, l'API repond 429 sur chaque
# appel et l'ecran photo affiche « quota epuise ».
# MISTRAL_MODEL est optionnelle. Par defaut mistral-medium-latest, qui lit
# correctement une assiette composee. mistral-small-latest coute moins cher et
# nomme plus grossierement.
MISTRAL_API_KEY=
MISTRAL_MODEL=

# En-tete d'identification exige par les conditions d'usage d'Open Food Facts.
OFF_USER_AGENT=NutriPerso/0.1 (usage personnel; https://github.com/giantprolu/nutri-perso)

# Lien iCloud d'un raccourci Sante deja assemble, facultatif.
# Renseigne, l'ecran « Activite depuis Sante » propose « Ajouter le raccourci »
# au lieu des cinq actions a monter a la main. A fabriquer une fois depuis un
# iPhone : monter le raccourci, puis Partager -> Copier le lien iCloud.
# Le raccourci doit poser deux questions a l'importation, l'adresse et le
# jeton : il est identique pour tout le monde et ne peut porter le jeton de
# personne. L'automatisation quotidienne, elle, n'est pas partageable — Apple
# n'exporte que les raccourcis.
HEALTH_SHORTCUT_URL=
