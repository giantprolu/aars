<?xml version="1.0" encoding="utf-8"?>
<!--
  Rien ne part en sauvegarde ni en transfert d'appareil : le jeton de session
  est chiffré par une clé du Keystore qui ne suit pas, et les données vivent
  sur le serveur. Une copie restaurée serait illisible.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
